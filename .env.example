# Optional: Set your Anthropic API key to enable AI-powered feedback summaries
# Without this key, DeckPulse will use a basic local summary instead
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Resend API key for sending magic link emails and feedback reports
# Without this key, magic links will be logged to the console instead
# Get a free key at https://resend.com
RESEND_API_KEY=your-resend-api-key-here

# Optional: Custom from address (requires a verified domain in Resend)
# EMAIL_FROM=DeckPulse <noreply@yourdomain.com>

# Optional: Base URL for magic link emails (defaults to http://localhost:3000)
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com
